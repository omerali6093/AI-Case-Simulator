# Copy to .env. Never commit real secrets.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/clinic_simulator
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Development with React (Vite dev server on :5173):
#   CLIENT_ORIGIN=http://localhost:5173
#   COOKIE_SAMESITE=lax
#
# Development with React (Vite proxying /api to :4000 — recommended):
#   CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Folder served at / when the backend also serves the built frontend.
# Point this to ../frontend-dist after running `npm run build` in frontend-react/.
FRONTEND_DIR=../frontend-dist

# lax is right when the page and API share a site.
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the API (so rate limits see the real client IP)
TRUST_PROXY=0
